# "auto" tries this site's /api first and falls back to calling Open-Meteo from the browser.
# "server" only uses /api; "browser" never calls /api (use for static hosting such as GitHub Pages).
VITE_API_MODE=auto
# Optional base for /api when the API is hosted elsewhere.
VITE_API_BASE=
# Server only (server/node.ts): a customer endpoint and key for commercial use. Never exposed to the browser.
OPEN_METEO_BASE=
OPEN_METEO_APIKEY=
PORT=8787
