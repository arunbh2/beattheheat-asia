  "failed to act", "failed to protect", "refused to", "ignored by", "turned a blind eye",
  "blame", "blamed", "culprit", "villain", "greedy", "predatory", "exploitative",
  "propaganda", "lies", "lied",
  "ruling party", "opposition party", "election campaign", "vote bank",
  "best in", "worst in", "ranked last", "lagging behind", "laggard", "leading the way",
  "slum", "slums", "slum-dweller", "slum dwellers",
  "victims", "the poor", "illegal migrants"
 ],
