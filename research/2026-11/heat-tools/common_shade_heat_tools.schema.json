{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Shade heat tool catalogue",
  "type": "object",
  "required": [
    "schema_version",
    "research_as_of",
    "sources",
    "records",
    "curated_pathways",
    "design",
    "filtering_policy",
    "research_protocol",
    "search_log",
    "research_backlog",
    "maintenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "research_as_of": {
      "type": "string",
      "format": "date"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "review_depth",
          "accessed_on"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_on": {
            "type": "string",
            "format": "date"
          },
          "review_depth": {
            "$ref": "#/$defs/review_depth"
          }
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "curated_pathways": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "kind",
          "steps"
        ],
        "properties": {
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "resource_ids",
                "purpose"
              ],
              "properties": {
                "resource_ids": {
                  "$ref": "#/$defs/strings"
                },
                "purpose": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "review_depth": {
      "enum": [
        "source_page_reviewed",
        "method_documentation_reviewed",
        "official_indexed_content_reviewed"
      ]
    },
    "record": {
      "type": "object",
      "required": [
        "id",
        "name",
        "provider",
        "origin",
        "resource_type",
        "decision_tags",
        "user_roles",
        "summary",
        "inputs",
        "outputs",
        "geography",
        "time_horizons",
        "heat_metrics",
        "method_summary",
        "limitations",
        "access",
        "technical",
        "evidence",
        "publication",
        "links",
        "field_provenance",
        "follow_up_checks"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string"
        },
        "origin": {
          "enum": [
            "external",
            "common_shade"
          ]
        },
        "resource_type": {
          "enum": [
            "assessment",
            "screening_tool",
            "modelling_tool",
            "data_portal",
            "dataset",
            "warning_service",
            "calculator",
            "guidance",
            "directory",
            "mobile_app",
            "planning_tool",
            "learning_exercise"
          ]
        },
        "decision_tags": {
          "$ref": "#/$defs/strings"
        },
        "user_roles": {
          "$ref": "#/$defs/strings"
        },
        "inputs": {
          "$ref": "#/$defs/strings"
        },
        "outputs": {
          "$ref": "#/$defs/strings"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "heat_metrics": {
          "$ref": "#/$defs/strings"
        },
        "time_horizons": {
          "$ref": "#/$defs/strings"
        },
        "geography": {
          "type": "object",
          "required": [
            "country_codes",
            "scope",
            "asia_applicability",
            "local_validation_countries",
            "spatial_scale"
          ],
          "properties": {
            "country_codes": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Z]{2}$"
              }
            },
            "local_validation_countries": {
              "$ref": "#/$defs/strings"
            }
          }
        },
        "access": {
          "type": "object",
          "required": [
            "mode",
            "registration_required",
            "price_amount",
            "currency",
            "licence",
            "licence_status",
            "rehosting_allowed"
          ],
          "properties": {
            "registration_required": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "rehosting_allowed": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "price_amount": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "licence": {
              "type": [
                "string",
                "null"
              ]
            },
            "currency": {
              "type": [
                "string",
                "null"
              ]
            },
            "mode": {
              "enum": [
                "public_read",
                "free_tool",
                "registration_for_data",
                "unknown",
                "paid",
                "freemium"
              ]
            }
          }
        },
        "technical": {
          "type": "object",
          "required": [
            "api_status",
            "api_docs_url",
            "integration_mode",
            "live_execution_tested"
          ],
          "properties": {
            "api_status": {
              "enum": [
                "documented_not_tested",
                "not_checked",
                "tested",
                "unavailable"
              ]
            },
            "api_docs_url": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uri"
                },
                {
                  "type": "null"
                }
              ]
            },
            "live_execution_tested": {
              "type": "boolean"
            },
            "integration_mode": {
              "enum": [
                "link_out",
                "api",
                "embedded"
              ]
            }
          }
        },
        "evidence": {
          "type": "object",
          "required": [
            "review_depth",
            "reviewed_on",
            "source_ids",
            "local_validation_status",
            "classification_basis"
          ],
          "properties": {
            "review_depth": {
              "$ref": "#/$defs/review_depth"
            },
            "reviewed_on": {
              "type": "string",
              "format": "date"
            },
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          }
        },
        "publication": {
          "type": "object",
          "required": [
            "status",
            "featured",
            "maintenance_status",
            "next_review_due"
          ],
          "properties": {
            "status": {
              "enum": [
                "documented_listing",
                "provisional_listing",
                "caution_listing",
                "archived"
              ]
            },
            "featured": {
              "type": "boolean"
            },
            "next_review_due": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "links": {
          "type": "object",
          "required": [
            "primary_url",
            "common_shade_next_step"
          ],
          "properties": {
            "primary_url": {
              "type": "string",
              "format": "uri"
            },
            "common_shade_next_step": {
              "type": "string",
              "pattern": "^/"
            }
          }
        }
      }
    }
  }
}
